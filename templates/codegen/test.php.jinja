    public function testFullCrud()
    {
        $result = json_decode($this->sendRequest(Credentials::requestLogin(Credentials::getAdminUser()))->getBody()->getContents(), true);

        $request = new FakeApiRequester();
        $request
            ->withPsr7Request($this->getPsr7Request())
            ->withMethod('POST')
            ->withPath("/{{ restPath }}")
            ->withRequestBody(json_encode($this->getSampleData(true)))
            ->expectStatus(200)
            ->withRequestHeader([
                "Authorization" => "Bearer " . $result['token']
            ])
        ;
        $body = $this->sendRequest($request);
        $bodyAr = json_decode($body->getBody()->getContents(), true);

        $request = new FakeApiRequester();
        $request
            ->withPsr7Request($this->getPsr7Request())
            ->withMethod('GET')
            ->withPath("/{{ restPath }}/" . $bodyAr['{{ fields.0.field }}'])
            ->expectStatus(200)
            ->withRequestHeader([
                "Authorization" => "Bearer " . $result['token']
            ])
        ;
        $this->sendRequest($request);

        // The key is in the path; the body has the same fields as the POST
        $request = new FakeApiRequester();
        $request
            ->withPsr7Request($this->getPsr7Request())
            ->withMethod('PUT')
            ->withPath("/{{ restPath }}/" . $bodyAr['{{ fields.0.field }}'])
            ->withRequestBody(json_encode($this->getSampleData(true)))
            ->expectStatus(200)
            ->withRequestHeader([
                "Authorization" => "Bearer " . $result['token']
            ])
        ;
        $this->sendRequest($request);
    }

    /**
     * The server refuses an invalid body with 400, not only the test client: these requests
     * are sent without the OpenAPI schema, so the client does not stop them and they reach
     * #[ValidateRequest] in the controller.
     */
    public function testInvalidPayloadIsRejectedByTheServer()
    {
        $result = json_decode($this->sendRequest(Credentials::requestLogin(Credentials::getAdminUser()))->getBody()->getContents(), true);
        $sample = $this->getSampleData(true);
        $collection = "/{{ restPath }}";
        $item = "/{{ restPath }}/{% if fields.0.php_type == 'int' %}1"{% else %}" . BaseRepository::getUuid(){% endif %};

        $invalid = [
            // The key is generated (POST) or taken from the path (PUT): the body cannot set it
            'POST with the key in the body' => ['POST', $collection, $sample + ['{{ primaryKeys.0 }}' => {% if fields.0.php_type == 'int' %}1{% else %}BaseRepository::getUuid(){% endif %}]],
            'PUT with the key in the body' => ['PUT', $item, $sample + ['{{ primaryKeys.0 }}' => {% if fields.0.php_type == 'int' %}1{% else %}BaseRepository::getUuid(){% endif %}]],
{% if nonNullableFields | count > 0 %}            'POST without the required fields' => ['POST', $collection, (object)[]],
            'PUT without the required fields' => ['PUT', $item, (object)[]],
{% endif %}{% for field in fields %}{% if field.openapi_min_length %}            'POST with an empty {{ field.property }}' => ['POST', $collection, array_merge($sample, ['{{ field.property }}' => ''])],
            'PUT with an empty {{ field.property }}' => ['PUT', $item, array_merge($sample, ['{{ field.property }}' => ''])],
{% endif %}{% endfor %}        ];

        foreach ($invalid as $case => [$method, $path, $payload]) {
            $request = new FakeApiRequester();
            $request
                ->withPsr7Request($this->getPsr7Request())
                ->withMethod($method)
                ->withPath($path)
                ->withRequestBody(json_encode($payload))
                ->withRequestHeader([
                    "Authorization" => "Bearer " . $result['token']
                ])
            ;

            try {
                $request->send();
                $this->fail("$case was accepted");
            } catch (Error400Exception) {
                $this->addToAssertionCount(1);
            }
        }
    }

